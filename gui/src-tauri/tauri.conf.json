{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reminder",
  "mainBinaryName": "reminder",
  "version": "0.1.1",
  "identifier": "com.trueryob.reminderproxyclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "reminder",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TrueRyoB",
    "copyright": "Copyright (c) 2026 TrueRyoB",
    "category": "Productivity",
    "shortDescription": "iCloud リマインダーのプロキシクライアント",
    "longDescription": "iOS 標準リマインダーを CloudKit 経由で読み書きする Windows 常駐クライアント。課題(pull)と通知(push)を分離した献立型ダッシュボードを備えます。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
